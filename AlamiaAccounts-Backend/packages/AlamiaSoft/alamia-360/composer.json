{
    "name": "alamia/alamia-360",
    "description": "Alamia 360 - Application-aware operational intelligence architecture for Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/bus": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Alamia360\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alamia360\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:unit": "vendor/bin/phpunit --testsuite=Unit --testdox",
        "test:integration": "vendor/bin/phpunit --testsuite=Integration --testdox"
    },
    "config": {
        "audit": {
            "abandoned": "report"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alamia360\\Alamia360ServiceProvider"
            ],
            "aliases": {
                "Alamia360": "Alamia360\\Facades\\Alamia360"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
